import { createClient } from "@/lib/supabase/server";
import { redirect } from "next/navigation";
import { revalidatePath } from "next/cache";

export default async function OnboardingPage() {
  const supabase = createClient();
  const {
    data: { user }
  } = await supabase.auth.getUser();
  if (!user) redirect("/login");

  async function saveOnboarding(formData: FormData) {
    "use server";
    const supabase = createClient();
    const {
      data: { user }
    } = await supabase.auth.getUser();
    if (!user) return;

    const priorContact = formData.get("prior_contact") === "yes";
    const studyDuration = Number(formData.get("study_duration") ?? 0);

    await supabase
      .from("profiles")
      .update({
        prior_english_contact: priorContact,
        study_duration_months: studyDuration,
        onboarding_completed: true
      })
      .eq("id", user.id);

    revalidatePath("/onboarding");
    redirect("/placement-test");
  }

  return (
    <main className="flex min-h-screen items-center justify-center bg-brand-cream px-6">
      <div className="w-full max-w-lg rounded-xl2 border border-brand-ink/10 bg-white p-8 shadow-sm">
        <span className="font-display text-xl text-brand-purple">Hey Teacher!</span>
        <h1 className="mt-6 font-display text-2xl text-brand-ink">Antes de começar...</h1>
        <p className="mt-2 text-brand-ink/60">
          Só mais duas perguntinhas rápidas pra sua professora entender melhor seu ponto de partida.
        </p>

        <form action={saveOnboarding} className="mt-8 space-y-6">
          <div>
            <p className="mb-3 text-sm font-medium text-brand-ink/70">
              Você já teve algum contato prévio com o inglês (escola, curso, autodidata)?
            </p>
            <div className="flex gap-3">
              <label className="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl2 border border-brand-ink/15 px-4 py-3 text-sm has-[:checked]:border-brand-purple has-[:checked]:bg-brand-lilac/20">
                <input type="radio" name="prior_contact" value="yes" required className="accent-brand-purple" />
                Sim
              </label>
              <label className="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl2 border border-brand-ink/15 px-4 py-3 text-sm has-[:checked]:border-brand-purple has-[:checked]:bg-brand-lilac/20">
                <input type="radio" name="prior_contact" value="no" required className="accent-brand-purple" />
                Não, começando do zero
              </label>
            </div>
          </div>

          <div>
            <label className="mb-2 block text-sm font-medium text-brand-ink/70">
              Aproximadamente quantos meses você já estudou inglês (0 se está começando agora)?
            </label>
            <input
              type="number"
              name="study_duration"
              min={0}
              max={600}
              defaultValue={0}
              required
              className="w-full rounded-lg border border-brand-ink/15 px-3 py-2 outline-none focus:border-brand-purple"
            />
          </div>

          <button
            type="submit"
            className="w-full rounded-full bg-brand-purple py-3 text-white transition hover:bg-brand-lilacDark"
          >
            Continuar para o teste de nivelamento
          </button>
        </form>
      </div>
    </main>
  );
}
