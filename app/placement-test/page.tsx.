import { createClient } from "@/lib/supabase/server";
import { redirect } from "next/navigation";

type Q = { id: string; prompt: string; options: string[]; correct: string };

const READING: Q[] = [
  { id: "r1", prompt: "Choose the correct translation: 'Bom dia'", options: ["Good morning", "Good night", "Good afternoon"], correct: "Good morning" },
  { id: "r2", prompt: "'She ___ a teacher.' Choose the correct verb.", options: ["is", "are", "am"], correct: "is" },
  { id: "r3", prompt: "What is the opposite of 'big'?", options: ["small", "tall", "fast"], correct: "small" },
  { id: "r4", prompt: "'I have been living here ___ 2020.' Choose the correct word.", options: ["since", "for", "at"], correct: "since" },
  { id: "r5", prompt: "Which sentence is correct?", options: ["If I would have known, I would have gone.", "If I had known, I would have gone.", "If I know, I would go."], correct: "If I had known, I would have gone." }
];

const WRITING: Q[] = [
  { id: "w1", prompt: "Complete: 'They ___ to the party yesterday.' (go)", options: ["went", "goes", "gone"], correct: "went" },
  { id: "w2", prompt: "Choose the correctly punctuated sentence.", options: ["im going home.", "I'm going home.", "Im going home"], correct: "I'm going home." },
  { id: "w3", prompt: "'Despite ___ tired, she finished the report.' Choose the correct word.", options: ["being", "be", "to be"], correct: "being" },
  { id: "w4", prompt: "Choose the correct plural: 'child'", options: ["childs", "children", "childes"], correct: "children" },
  { id: "w5", prompt: "'Not only ___ she late, but she also forgot her laptop.'", options: ["was", "did", "she was"], correct: "was" }
];

const LISTENING: Q[] = [
  { id: "l1", prompt: "(Áudio simulado) A pessoa diz: 'Nice to meet you.' O que ela quis dizer?", options: ["Prazer em conhecê-lo", "Vejo você depois", "Bom trabalho"], correct: "Prazer em conhecê-lo" },
  { id: "l2", prompt: "(Áudio simulado) 'Could you repeat that, please?' significa:", options: ["Pode repetir, por favor?", "Você pode me ajudar?", "Qual é o seu nome?"], correct: "Pode repetir, por favor?" },
  { id: "l3", prompt: "(Áudio simulado) 'The meeting has been rescheduled to Friday.' O que aconteceu com a reunião?", options: ["Foi cancelada", "Foi remarcada pra sexta", "Já aconteceu"], correct: "Foi remarcada pra sexta" },
  { id: "l4", prompt: "(Áudio simulado) 'I used to live in Brazil.' Isso significa que a pessoa:", options: ["Mora no Brasil agora", "Morava no Brasil no passado", "Vai morar no Brasil"], correct: "Morava no Brasil no passado" },
  { id: "l5", prompt: "(Áudio simulado) 'Turn left at the second light.' A instrução é sobre:", options: ["Uma receita de comida", "Uma direção/rota", "Um horário de aula"], correct: "Uma direção/rota" }
];

function levelFromScore(avg: number): string {
  if (avg < 20) return "A1";
  if (avg < 40) return "A2";
  if (avg < 65) return "B1";
  if (avg < 85) return "B2";
  return "C1";
}

export default async function PlacementTestPage() {
  const supabase = createClient();
  const {
    data: { user }
  } = await supabase.auth.getUser();
  if (!user) redirect("/login");

  const { data: existing } = await supabase
    .from("placement_tests")
    .select("id")
    .eq("student_id", user.id)
    .maybeSingle();

  if (existing) redirect("/student/dashboard");

  async function submitTest(formData: FormData) {
    "use server";
    const supabase = createClient();
    const {
      data: { user }
    } = await supabase.auth.getUser();
    if (!user) return;

    function scoreSection(questions: Q[]) {
      let correct = 0;
      for (const q of questions) {
        const answer = String(formData.get(q.id) ?? "");
        if (answer === q.correct) correct += 1;
      }
      return (correct / questions.length) * 100;
    }

    const readingScore = scoreSection(READING);
    const writingScore = scoreSection(WRITING);
    const listeningScore = scoreSection(LISTENING);
    const avg = (readingScore + writingScore + listeningScore) / 3;
    const level = levelFromScore(avg);

    await supabase.from("placement_tests").insert({
      student_id: user.id,
      reading_score: readingScore,
      writing_score: writingScore,
      listening_score: listeningScore,
      level_assigned: level
    });

    await supabase.from("profiles").update({ cefr_level: level }).eq("id", user.id);

    redirect("/student/dashboard");
  }

  function renderSection(title: string, questions: Q[]) {
    return (
      <div className="rounded-xl2 border border-brand-ink/10 bg-white p-6">
        <p className="mb-4 font-display text-lg text-brand-purple">{title}</p>
        <div className="space-y-5">
          {questions.map((q, idx) => (
            <div key={q.id}>
              <p className="text-sm font-medium text-brand-ink">
                {idx + 1}. {q.prompt}
              </p>
              <div className="mt-2 space-y-1">
                {q.options.map((opt) => (
                  <label key={opt} className="flex cursor-pointer items-center gap-2 text-sm text-brand-ink/80">
                    <input type="radio" name={q.id} value={opt} required className="accent-brand-purple" />
                    {opt}
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  return (
    <main className="min-h-screen bg-brand-cream px-6 py-10 md:px-12">
      <div className="mx-auto max-w-2xl">
        <span className="font-display text-xl text-brand-purple">Hey Teacher!</span>
        <h1 className="mt-4 font-display text-3xl text-brand-ink">Teste de nivelamento</h1>
        <p className="mt-2 text-brand-ink/60">
          Reading, Writing e Listening são corrigidos automaticamente. Speaking será avaliado pela sua professora
          na primeira aula.
        </p>

        <form action={submitTest} className="mt-8 space-y-6">
          {renderSection("Reading", READING)}
          {renderSection("Writing", WRITING)}
          {renderSection("Listening", LISTENING)}

          <div className="rounded-xl2 border border-brand-ink/10 bg-white p-6">
            <p className="mb-2 font-display text-lg text-brand-purple">Speaking</p>
            <p className="text-sm text-brand-ink/60">
              Essa parte não tem correção automática — sua professora vai avaliar sua fala ao vivo na primeira
              aula e registrar o resultado no seu perfil.
            </p>
          </div>

          <button
            type="submit"
            className="w-full rounded-full bg-brand-purple py-3 text-white transition hover:bg-brand-lilacDark"
          >
            Enviar teste e ver meu resultado
          </button>
        </form>
      </div>
    </main>
  );
}
